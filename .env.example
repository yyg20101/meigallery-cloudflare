# MeiGallery 环境变量模板
# 复制此文件为 .env 并填入实际值

# ============================================================
# API Worker（packages/api）
# ============================================================

# Session 签名密钥（至少 32 字符随机字符串）
SESSION_SECRET=change-me-to-a-random-secret-at-least-32-chars

# API 运行环境与 CORS 白名单（多个 Origin 使用英文逗号分隔）
APP_ENV=development
CORS_ORIGIN=http://localhost:3000

# 事务性邮件发件人
EMAIL_FROM=noreply@example.com

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=

# Cloudflare Stream
STREAM_ACCOUNT_ID=
STREAM_API_TOKEN=

# 图片缩放开关：Free 计划建议 false，升级 Image Resizing 后可设为 true
IMAGE_RESIZING_ENABLED=false

# 外部 Telegram 导入安全限制
IMPORT_TOKEN_DAILY_LIMIT=100
TELEGRAM_BOT_TOKEN_OPS_GALLERY_BOT=

# ============================================================
# Web Worker（packages/web）
# ============================================================

# API Worker 地址（本地开发时为 http://localhost:8787）
NUXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Turnstile 前端 site key
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# 站点 URL
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_APP_ENV=development
