# MeiGallery 环境变量模板
# 复制此文件为 .env 并填入实际值

# 应用环境
APP_ENV=development

# Session 签名密钥（至少 32 字符随机字符串）
NUXT_SESSION_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Cloudflare Turnstile
NUXT_TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# R2 存储桶名称
NUXT_R2_BUCKET_NAME=meigallery-media

# Cloudflare Stream
NUXT_STREAM_ACCOUNT_ID=
NUXT_STREAM_API_TOKEN=

# 站点 URL
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_APP_ENV=development
