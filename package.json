{
  "name": "meigallery-cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "中文响应式图库平台 - Cloudflare Workers 全栈部署（monorepo）",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @meigallery/web dev",
    "dev:api": "pnpm --filter @meigallery/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @meigallery/web build",
    "build:api": "pnpm --filter @meigallery/api build",
    "deploy": "pnpm -r deploy",
    "deploy:web": "pnpm --filter @meigallery/web deploy",
    "deploy:api": "pnpm --filter @meigallery/api deploy",
    "lint": "eslint \"packages/**/*.{ts,js,mjs,vue}\" --max-warnings=0",
    "typecheck": "pnpm -r typecheck",
    "db:migrate:local": "pnpm --filter @meigallery/api db:migrate:local",
    "db:migrate:remote": "pnpm --filter @meigallery/api db:migrate:remote"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.60.0",
    "vue-eslint-parser": "^10.4.0"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=20.0.0"
  }
}
