{
  "name": "meigallery-cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "中文响应式图库平台 - Cloudflare Workers 全栈部署（monorepo）",
  "scripts": {
    "dev": "corepack pnpm -r --parallel dev",
    "dev:web": "corepack pnpm --filter @meigallery/web dev",
    "dev:api": "corepack pnpm --filter @meigallery/api dev",
    "build": "corepack pnpm -r build",
    "build:web": "corepack pnpm --filter @meigallery/web build",
    "build:api": "corepack pnpm --filter @meigallery/api build",
    "deploy": "corepack pnpm -r deploy",
    "deploy:web": "corepack pnpm --filter @meigallery/web deploy",
    "deploy:api": "corepack pnpm --filter @meigallery/api deploy",
    "verify:quick": "node scripts/verify-release.mjs quick",
    "verify:local-runtime": "node scripts/verify-release.mjs local-runtime",
    "verify:dev-rehearsal": "node scripts/verify-release.mjs dev-rehearsal",
    "verify:release": "node scripts/verify-release.mjs release",
    "verify:meta-migration": "node scripts/verify-meta-migration.mjs",
    "verify:meta-live": "node scripts/record-meta-live-verification.mjs",
    "verify:meta-resources": "node scripts/verify-meta-resources.mjs",
    "verify:meta-secrets": "node scripts/verify-meta-secret-leaks.mjs",
    "verify:seo:production": "node scripts/verify-production-seo.mjs",
    "test:scripts": "node --test scripts/*.test.mjs packages/api/migrations/*.test.mjs",
    "lint": "eslint \"packages/**/*.{ts,js,mjs,vue}\" --max-warnings=0",
    "typecheck": "corepack pnpm -r typecheck",
    "db:migrate:local": "corepack pnpm --filter @meigallery/api db:migrate:local",
    "db:migrate:remote": "corepack pnpm --filter @meigallery/api db:migrate:remote"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "glob": "^13.0.6"
    }
  },
  "packageManager": "pnpm@10.34.4+sha512.8768be55200ae3f2226b6527fcca2687e14bc4e5f12d7721a0f25da3df47915177058648db4177baf348120fa0ba2752d8d8d93f6beaf1fe64ae18da8de961af",
  "engines": {
    "node": "^22.12.0 || ^24.11.0 || >=26.0.0"
  }
}
