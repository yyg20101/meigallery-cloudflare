{
  "name": "@meigallery/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "build": "wrangler deploy --env=\"\" --dry-run --outdir=dist",
    "deploy": "wrangler deploy --env=\"\"",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply meigallery-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply meigallery-db --env=\"\" --remote"
  },
  "dependencies": {
    "@meigallery/shared": "workspace:*",
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260623.1",
    "@vitest/coverage-v8": "4.1.9",
    "miniflare": "4.20260617.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
