{
  "name": "@meigallery/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "build": "wrangler deploy --env=\"\" --dry-run --outdir=dist",
    "deploy": "wrangler deploy --env=\"\"",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply meigallery-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply meigallery-db --env=\"\" --remote"
  },
  "dependencies": {
    "@meigallery/shared": "workspace:*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.86.0"
  }
}
