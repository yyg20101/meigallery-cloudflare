{
  "name": "@meigallery/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "build": "wrangler deploy --env=\"\" --dry-run --outdir=dist",
    "deploy": "node -e \"console.error('PRODUCTION_DEPLOY_REQUIRES_ROOT_SCRIPT'); process.exit(1)\"",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply meigallery-db --local",
    "db:migrate:remote": "node -e \"console.error('PRODUCTION_MIGRATION_REQUIRES_DEPLOY_SCRIPT'); process.exit(1)\""
  },
  "dependencies": {
    "@meigallery/shared": "workspace:*",
    "hono": "^4.12.29"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260712.1",
    "@vitest/coverage-v8": "4.1.10",
    "miniflare": "4.20260708.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
